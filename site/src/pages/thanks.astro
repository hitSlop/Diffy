  <main id="main" class="download-page frame">
    <img class="character" src="/chameleon.webp" width="112" height="112" alt="Diffy’s chameleon" />
    <h1>Hey. Here’s Diffy.</h1>
    <p class="intro">Thanks for being here.</p>
    <p class="compatibility">One purchase supports all platforms. Requires Git.</p>
    <Downloads />
    <p class="download-note">Save <a href="/downloads">diffy.hitslop.com/downloads</a> for future releases.</p>
  </main>
</Page>
