---
import { Image } from 'astro:assets';
import hero from '../assets/hero.png';
---

<div class="mascot" data-mascot>
  <Image src={hero} widths={[480, 960, 1440]} sizes="(max-width: 515px) calc(100vw - 36px), 480px" format="webp" quality={95} alt={'A tearful developer at a keyboard says, “thank you for changing my life.” Diffy’s colorful chameleon replies, “i literally only show you diffs.”'} loading="eager" fetchpriority="high" />
  <svg class="mascot-eye" viewBox="0 0 1860 845" aria-hidden="true" focusable="false">
    <defs>
      <path id="diffy-eye-opening" d="M1198 545C1198 497 1239 449 1279 447C1330 443 1384 478 1401 526C1424 584 1376 633 1329 638C1273 646 1218 620 1202 574C1199 564 1198 554 1198 545Z" />
      <clipPath id="diffy-eye-clip"><use href="#diffy-eye-opening" /></clipPath>
      <radialGradient id="diffy-sclera" gradientUnits="userSpaceOnUse" cx="1278" cy="480" r="169">
        <stop offset="0" stop-color="#feffff" /><stop offset=".33" stop-color="#fffef0" /><stop offset=".62" stop-color="#d8ffd0" /><stop offset=".82" stop-color="#9bf5b1" /><stop offset="1" stop-color="#28ca63" />
      </radialGradient>
      <radialGradient id="diffy-pupil" cx="35%" cy="15%" r="95%">
        <stop offset="0" stop-color="#474c51" /><stop offset=".3" stop-color="#101519" /><stop offset=".7" stop-color="#010806" /><stop offset=".9" stop-color="#082b17" /><stop offset="1" stop-color="#11150a" />
      </radialGradient>
      <linearGradient id="diffy-pupil-edge" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#111713" /><stop offset=".5" stop-color="#010500" /><stop offset="1" stop-color="#385422" />
      </linearGradient>
    </defs>
    <g clip-path="url(#diffy-eye-clip)">
      <use href="#diffy-eye-opening" fill="url(#diffy-sclera)" />
      <g data-pupil>
        <g transform="rotate(18 1247 531)">
          <ellipse cx="1247" cy="531" rx="45" ry="62" fill="url(#diffy-pupil)" stroke="url(#diffy-pupil-edge)" stroke-width="3" />
          <ellipse cx="1229" cy="501" rx="12" ry="16" fill="#fff" />
        </g>
      </g>
    </g>
  </svg>
</div>

<script>
  const mascot = document.querySelector<HTMLElement>('[data-mascot]');
  const pupil = mascot?.querySelector<SVGGElement>('[data-pupil]');
  if (mascot && pupil) {
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    let enabled = false;
    let frame = 0;
    let previousTime = 0;
    let x = 0, y = 0, targetX = 0, targetY = 0;
    let aimPending = false;
    let lastPointer: { x: number; y: number } | undefined;

    const stop = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      previousTime = 0;
    };
    const paint = () => pupil.setAttribute('transform', `translate(${x.toFixed(2)} ${y.toFixed(2)})`);
    const animate = (time: number) => {
      frame = 0;
      if (!enabled || !visible || document.hidden) return;
      if (aimPending) { aimPending = false; measureAim(); }
      const dt = previousTime ? Math.min((time - previousTime) / 1000, .05) : 1 / 60;
      previousTime = time;
      const ease = 1 - Math.exp(-14 * dt);
      x += (targetX - x) * ease;
      y += (targetY - y) * ease;
      if (Math.abs(targetX - x) + Math.abs(targetY - y) < .08) {
        x = targetX;
        y = targetY;
        previousTime = 0;
        if (!lastPointer) mascot.classList.remove('is-tracking');
      } else {
        frame = requestAnimationFrame(animate);
      }
      paint();
    };
    const start = () => {
      if (enabled && visible && !document.hidden && !frame) frame = requestAnimationFrame(animate);
    };
    const neutral = () => {
      lastPointer = undefined;
      aimPending = false;
      targetX = targetY = 0;
      start();
    };
    const measureAim = () => {
      if (!enabled || !visible || !lastPointer) return;
      const box = mascot.getBoundingClientRect();
      const dx = lastPointer.x - (box.left + box.width * 1302 / 1860);
      const dy = lastPointer.y - (box.top + box.height * 545 / 845);
      const distance = Math.hypot(dx, dy);
      // Work in banner coordinates so the eye and its travel scale together.
      // The original pupil looks left; aim around the center of the eyeball.
      const strength = Math.min(distance / Math.max(box.width * .2, 1), 1);
      targetX = 55 + (distance ? dx / distance * strength * 40 : 0);
      targetY = 14 + (distance ? dy / distance * strength * 25 : 0);
      mascot.classList.add('is-tracking');
    };
    const aim = () => {
      if (!enabled || !visible || !lastPointer) return;
      aimPending = true;
      start();
    };
    const configure = () => {
      enabled = finePointer.matches && !reducedMotion.matches;
      stop();
      x = y = targetX = targetY = 0;
      paint();
      mascot.classList.remove('is-tracking');
      if (enabled) aim();
    };
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) { aim(); start(); } else stop();
    }).observe(mascot);
    window.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || !enabled || !visible) return;
      lastPointer = { x: event.clientX, y: event.clientY };
      aim();
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', neutral);
    window.addEventListener('blur', neutral);
    window.addEventListener('resize', aim, { passive: true });
    window.addEventListener('scroll', aim, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { neutral(); stop(); } else start();
    });
    finePointer.addEventListener('change', configure);
    reducedMotion.addEventListener('change', configure);
    configure();
  }
</script>
