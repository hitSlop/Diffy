# Build outputs and local reference checkouts
/target/
/dist/
/_docs/
/site/node_modules/
/site/dist/
/site/.astro/
/site/.wrangler/

# Local secrets, logs, and editor scratch files
.env
.env.*
!.env.example
*.log
*.swp
*.swo
*~
.DS_Store

# Cargo registry bookkeeping copied with vendored dependencies
/vendor/**/.cargo-ok
/vendor/**/.cargo_vcs_info.json
/vendor/**/Cargo.lock


# Release signing keys and generated assets
/.release-secrets/

# Python script caches
__pycache__/
*.pyc

# Finder iconset resource metadata
/assets/icon/icon.iconset/Icon?

# Never commit certificate exports, provisioning profiles, or private key files
*.p12
*.pfx
*.pem
*.cer
*.crt
*.cert
*.mobileprovision
*.provisionprofile
*.key
!tests/fixtures/update/public.key
